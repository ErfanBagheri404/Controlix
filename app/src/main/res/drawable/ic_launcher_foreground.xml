        android:pathData="M47.8,41 a6.2,6.2 0 1 0 12.4,0 a6.2,6.2 0 1 0 -12.4,0 z" />
    <path android:fillColor="#FF1ED760"
        android:pathData="M50.5,41 a3.5,3.5 0 1 0 7,0 a3.5,3.5 0 1 0 -7,0 z" />

