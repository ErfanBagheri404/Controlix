<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher foreground: flat filled remote-handset silhouette, details cut out as
     negative space. Art is authored at 27x61 of the 108 grid but drawn at 78% about
     the centre, landing at ~21x48dp. Adaptive icons only show the middle 72dp of the
     108 grid, so that is ~66% of the visible mask: clear space on every side.
     Monochrome-safe. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

  <group android:scaleX="0.78" android:scaleY="0.78"
      android:translateX="11.88" android:translateY="11.88">

    <!-- Handset body: 27x61 stadium, fully rounded ends -->
