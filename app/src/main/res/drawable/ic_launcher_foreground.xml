<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher foreground: a remote handset in the app's Lucide stroke style.
     Rounded body + power dot + 3x3 key grid, emerald on the theme background.
     Monochrome-safe: only stroke shapes and one fill, no gradients. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- Handset body -->
    <path android:strokeColor="#FF1ED760" android:strokeWidth="4"
        android:pathData="M44,22 h20 a8,8 0 0 1 8,8 v48 a8,8 0 0 1 -8,8 h-20 a8,8 0 0 1 -8,-8 v-48 a8,8 0 0 1 8,-8 z"
        android:fillColor="#00000000" android:strokeLineCap="round" android:strokeLineJoin="round" />

    <!-- Emitter eye -->
    <path android:fillColor="#FF1ED760"
        android:pathData="M51,30 h6 v6 h-6 z" />

    <!-- Power row -->
    <path android:strokeColor="#FF1ED760" android:strokeWidth="3"
        android:pathData="M50,46 a4,4 0 1 0 8,0 M54,42 v4"
        android:fillColor="#00000000" android:strokeLineCap="round" />

    <!-- 3x3 key grid -->
    <path android:fillColor="#FF1ED760"
        android:pathData="M45,56 h4 v4 h-4 z M52,56 h4 v4 h-4 z M59,56 h4 v4 h-4 z M45,64 h4 v4 h-4 z M52,64 h4 v4 h-4 z M59,64 h4 v4 h-4 z M45,72 h4 v4 h-4 z M52,72 h4 v4 h-4 z M59,72 h4 v4 h-4 z" />
</vector>
