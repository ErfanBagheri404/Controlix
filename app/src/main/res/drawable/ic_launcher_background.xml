<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: a deep-emerald spotlight behind the handset,
     the same hue family as the body (#3BF08A → #0E9E52) but far darker, so
     the bright mint remote reads as the lit object in a dark forest.
     A near-complementary hue fights the glyph; the monochromatic ramp keeps
     the whole icon one material.

     Centre sits high (54,42) to meet the handset; radius 58 puts the corners
     past the gradient, so circle (~72%) and squircle masks both land in the
     dark end with no visible seam. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

  <path android:pathData="M0,0 h108 v108 h-108 z">
    <aapt:attr name="android:fillColor">
      <gradient android:type="radial"
          android:centerX="54" android:centerY="42"
          android:gradientRadius="58"
          android:startColor="#1B5E3A"
          android:centerColor="#0E3A24"
          android:endColor="#04120A" />
    </aapt:attr>
  </path>

</vector>
